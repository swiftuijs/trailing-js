{
  "name": "@swiftuijs/twill-formatter",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swiftuijs/twill.git",
    "directory": "packages/formatter"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./standalone": {
      "types": "./dist/standalone.d.ts",
      "import": "./dist/standalone.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && twill declarations -p tsconfig.build.json -o dist",
    "typecheck": "twill check -p tsconfig.json",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:package": "node tests/consumer.mjs",
    "prepack": "pnpm run build",
    "benchmark:project": "node benchmarks/project.mjs",
    "test": "pnpm run test:unit"
  },
  "dependencies": {
    "@swiftuijs/twill": "workspace:*",
    "magic-string": "^1.4.2",
    "acorn": "8.18.0"
  },
  "devDependencies": {
    "vite": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "prettier": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "prettier": "^3.9.9"
  },
  "author": {
    "name": "forth.ink",
    "url": "https://forth.ink"
  },
  "homepage": "https://twill.evecalm.com/",
  "bugs": {
    "url": "https://github.com/swiftuijs/twill/issues"
  },
  "keywords": [
    "twill",
    "prettier",
    "prettier-plugin",
    "typescript",
    "formatter"
  ],
  "description": "Prettier plugin for Twill: format trailing closures, guards, defer and TS/TSX while preserving source syntax."
}
