{
  "name": "@swiftuijs/twill-formatter",
  "version": "0.8.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swiftuijs/twill.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:package": "node tests/consumer.mjs",
    "prepack": "pnpm run build",
    "benchmark:project": "node benchmarks/project.mjs",
    "test": "pnpm run test:unit"
  },
  "dependencies": {
    "@swiftuijs/twill": "workspace:*",
    "magic-string": "^1.4.2",
    "acorn": "8.18.0"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plugin-dts": "^5.1.2",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "prettier": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "prettier": "^3.9.9"
  }
}
