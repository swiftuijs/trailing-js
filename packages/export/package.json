{
  "name": "@swiftuijs/twill-export",
  "version": "0.3.0",
  "description": "Export a checked Twill source project to formatted native TypeScript.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swiftuijs/twill.git",
    "directory": "packages/export"
  },
  "homepage": "https://twill.evecalm.com/",
  "bugs": {
    "url": "https://github.com/swiftuijs/twill/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@swiftuijs/twill": "workspace:*",
    "@swiftuijs/twill-formatter": "workspace:*",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "magic-string": "^1.4.2"
  },
  "devDependencies": {
    "vite": "catalog:",
    "@types/node": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:"
  },
  "scripts": {
    "build": "vite build && twill declarations -p tsconfig.build.json -o dist",
    "typecheck": "twill check -p tsconfig.json",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:package": "node tests/consumer.mjs",
    "prepack": "pnpm run build"
  },
  "author": {
    "name": "forth.ink",
    "url": "https://forth.ink"
  },
  "keywords": [
    "twill",
    "typescript",
    "source-export"
  ]
}
