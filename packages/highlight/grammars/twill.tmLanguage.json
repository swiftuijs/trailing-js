{
  "name": "Twill ts",
  "scopeName": "source.twill.ts",
  "patterns": [
    {
      "include": "#implicit-member"
    },
    {
      "include": "#defer"
    },
    {
      "include": "#guard-binding"
    },
    {
      "include": "#guard"
    },
    {
      "include": "#switch-expression"
    },
    {
      "include": "#closure-header"
    },
    {
      "match": "(?<=\\})\\s*\\b([A-Za-z_$][\\w$]*)(\\s*:)(?=\\s*\\{)",
      "captures": {
        "1": {
          "name": "entity.name.function.twill"
        },
        "2": {
          "name": "punctuation.separator.twill"
        }
      }
    },
    {
      "include": "source.ts"
    }
  ],
  "repository": {
    "implicit-member": {
      "begin": "(?<![\\w$.)}\\]])(\\.)([A-Za-z_$][\\w$]*)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.accessor.twill"
        },
        "2": {
          "name": "variable.other.property.twill"
        }
      },
      "end": "(?=;|})",
      "name": "meta.implicit.expression.twill",
      "patterns": [
        {
          "include": "source.ts#expression"
        }
      ]
    },
    "defer": {
      "match": "(?<![\\w$.])\\bdefer\\b(?=(?:[^\\S\\r\\n]|/\\*[^\\r\\n]*?\\*/)*\\{)",
      "name": "keyword.control.twill"
    },
    "guard": {
      "match": "(?<![\\w$.])\\bguard\\b(?=\\s+(?:const\\b|[^\\s;=:]))",
      "name": "keyword.control.twill"
    },
    "guard-binding": {
      "name": "meta.guard.binding.twill",
      "begin": "(?<![\\w$.])\\b(guard)\\s+(const)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.twill"
        },
        "2": {
          "name": "storage.type.ts"
        }
      },
      "end": "(?<![\\w$.])\\belse\\b(?=\\s*\\{)",
      "endCaptures": {
        "0": {
          "name": "keyword.control.twill"
        }
      },
      "patterns": [
        {
          "include": "source.ts#object-binding-pattern-const"
        },
        {
          "include": "source.ts#array-binding-pattern-const"
        },
        {
          "include": "source.ts"
        }
      ]
    },
    "switch-expression": {
      "name": "meta.switch.expression.twill",
      "begin": "(?<![\\w$.])(switch)\\b(?=\\s*\\()",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.twill"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.twill"
        }
      },
      "patterns": [
        {
          "include": "source.ts#comment"
        },
        {
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            {
              "include": "source.ts#expression"
            }
          ]
        },
        {
          "begin": "\\{",
          "end": "(?=\\})",
          "patterns": [
            {
              "begin": "(?<![\\w$.])(case|default)\\b",
              "beginCaptures": {
                "1": {
                  "name": "keyword.control.twill"
                }
              },
              "end": "(?=:)",
              "patterns": [
                {
                  "include": "#enum-pattern"
                },
                {
                  "include": "source.ts#expression"
                }
              ]
            },
            {
              "include": "source.ts#statements"
            }
          ]
        }
      ]
    },
    "closure-header": {
      "begin": "(\\{)(?=\\s*(?:async\\s+)?(?:[A-Za-z_$][\\w$]*(?:\\s*,\\s*[A-Za-z_$][\\w$]*)*|\\((?:[^;()]|\\([^()]*\\))*\\)(?:\\s*:[^;{}]*?)?)\\s+in\\b)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.block.begin.twill"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.twill"
        }
      },
      "name": "meta.trailing.closure.twill",
      "patterns": [
        {
          "begin": "(?<=\\{)",
          "end": "\\bin\\b",
          "endCaptures": {
            "0": {
              "name": "keyword.control.twill"
            }
          },
          "patterns": [
            {
              "include": "source.ts#comment"
            },
            {
              "match": "\\basync\\b",
              "name": "storage.modifier.ts"
            },
            {
              "include": "source.ts#function-parameters"
            },
            {
              "begin": ":",
              "end": "(?=\\bin\\b)",
              "patterns": [
                {
                  "include": "source.ts#type"
                }
              ]
            },
            {
              "include": "source.ts#parameter-name"
            }
          ]
        },
        {
          "include": "source.ts#statements"
        }
      ]
    },
    "enum-case": {
      "begin": "\\b(case)\\b(?=(?:\\s|/\\*.*?\\*/)*[[:alpha:]_$])",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.twill"
        }
      },
      "end": "([[:alpha:]_$][\\w$]*)",
      "endCaptures": {
        "1": {
          "name": "entity.name.function.twill"
        }
      },
      "patterns": [
        {
          "include": "source.ts#comment"
        }
      ]
    },
    "enum-pattern": {
      "begin": "\\b(enum)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.twill"
        }
      },
      "end": "(?=\\()",
      "patterns": [
        {
          "include": "source.ts#comment"
        },
        {
          "match": "([[:alpha:]_$][\\w$]*)(\\s*)(\\.)",
          "captures": {
            "1": {
              "name": "entity.name.type.twill"
            },
            "3": {
              "name": "punctuation.accessor.twill"
            }
          }
        },
        {
          "match": "[[:alpha:]_$][\\w$]*",
          "name": "entity.name.function.twill"
        }
      ]
    }
  },
  "injections": {
    "L:source.twill.ts -comment -string, L:source.twill.ts meta.template.expression -comment -(meta.template.expression string)": {
      "patterns": [
        {
          "include": "#implicit-member"
        },
        {
          "include": "#defer"
        },
        {
          "include": "#guard-binding"
        },
        {
          "include": "#guard"
        },
        {
          "include": "#switch-expression"
        },
        {
          "include": "#closure-header"
        }
      ]
    },
    "L:source.twill.ts meta.enum.declaration.ts -comment -string": {
      "patterns": [
        {
          "include": "source.ts#type-parameters"
        },
        {
          "include": "#enum-case"
        },
        {
          "include": "source.ts#function-parameters"
        }
      ]
    }
  }
}
