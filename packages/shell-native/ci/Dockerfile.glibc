FROM rockylinux/rockylinux:8.10
RUN dnf install -y gcc gcc-c++ make python3 curl git gzip tar xz ca-certificates && dnf clean all
ENV CARGO_HOME=/usr/local/cargo RUSTUP_HOME=/usr/local/rustup
ENV PATH=/opt/node/bin:/usr/local/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o /tmp/rustup.sh \
 && sh /tmp/rustup.sh -y --profile minimal --default-toolchain 1.90.0 --component rustfmt --component clippy \
 && rm /tmp/rustup.sh
# Resolve and verify the current Node 22 release on the actual runner CPU.
RUN set -eu; case "$(uname -m)" in x86_64) node_arch=x64;; aarch64) node_arch=arm64;; *) exit 1;; esac; \
 curl -fsSL https://nodejs.org/dist/latest-v22.x/SHASUMS256.txt -o /tmp/node-shasums; \
 node_file=$(awk -v arch="$node_arch" '$2 ~ "-linux-" arch "\\.tar\\.xz$" {print $2}' /tmp/node-shasums); \
 test -n "$node_file"; curl -fsSL "https://nodejs.org/dist/latest-v22.x/$node_file" -o "/tmp/$node_file"; \
 cd /tmp; awk -v file="$node_file" '$2 == file' node-shasums | sha256sum -c -; \
 mkdir -p /opt/node; tar -xJf "$node_file" --strip-components=1 -C /opt/node; rm "$node_file" node-shasums; \
 npm install -g pnpm@11.19.0
RUN set -eu; case "$(uname -m)" in x86_64) node_arch=x64;; aarch64) node_arch=arm64;; *) exit 1;; esac; \
 node_file="node-v20.19.0-linux-$node_arch.tar.xz"; \
 curl -fsSL https://nodejs.org/dist/v20.19.0/SHASUMS256.txt -o /tmp/node20-shasums; \
 curl -fsSL "https://nodejs.org/dist/v20.19.0/$node_file" -o "/tmp/$node_file"; \
 cd /tmp; awk -v file="$node_file" '$2 == file' node20-shasums | sha256sum -c -; \
 mkdir -p /opt/node20; tar -xJf "$node_file" --strip-components=1 -C /opt/node20; rm "$node_file" node20-shasums
WORKDIR /workspace
