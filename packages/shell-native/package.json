{
  "name": "@swiftuijs/twill-shell-native",
  "version": "0.1.2",
  "description": "Optional Rust asynchronous subprocess backend for Twill shell scripts and Node.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swiftuijs/twill.git",
    "directory": "packages/shell-native"
  },
  "homepage": "https://twill.evecalm.com/scripting",
  "bugs": {
    "url": "https://github.com/swiftuijs/twill/issues"
  },
  "files": [
    "dist",
    "native",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@swiftuijs/twill-shell": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:native": "node scripts/check.mjs",
    "test:package": "node tests/consumer.mjs",
    "prepack": "node scripts/verify-binaries.mjs",
    "benchmark": "node benchmarks/benchmark.mjs"
  },
  "author": {
    "name": "forth.ink",
    "url": "https://forth.ink"
  },
  "keywords": [
    "twill",
    "shell",
    "subprocess",
    "rust",
    "napi",
    "swift",
    "node"
  ]
}
