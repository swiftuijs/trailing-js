{
  "name": "@swiftuijs/twill",
  "version": "0.1.1",
  "description": "Twill: a JS/TS syntax-sugar language with trailing closures, guards, block-scoped defer, build plugins, type checking, and editor support.",
  "main": "./dist/typescript-plugin.cjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swiftuijs/twill.git",
    "directory": "packages/twill"
  },
  "keywords": [
    "javascript",
    "typescript",
    "trailing-closures",
    "swift",
    "vite",
    "unplugin",
    "react",
    "vue",
    "twill",
    "guard",
    "defer"
  ],
  "author": {
    "name": "forth.ink",
    "url": "https://forth.ink"
  },
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/swiftuijs/twill/issues"
  },
  "homepage": "https://twill.evecalm.com/",
  "dependencies": {
    "@ampproject/remapping": "^2.3.0",
    "@jridgewell/trace-mapping": "^0.3.31",
    "acorn": "8.18.0",
    "acorn-jsx": "^5.3.2",
    "acorn-typescript": "1.4.13",
    "magic-string": "^1.4.2",
    "typescript": "catalog:",
    "unplugin": "^3.4.0"
  },
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "files": [
    "bin",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "schemas",
    "README.md",
    "LICENSE",
    "dist/**/*.cjs",
    "dist/**/*.cjs.map",
    "dist/*.LICENSE.txt"
  ],
  "bin": {
    "twill": "./bin/twill.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./rollup": {
      "types": "./dist/rollup.d.ts",
      "import": "./dist/rollup.js"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "import": "./dist/esbuild.js"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "import": "./dist/webpack.js"
    },
    "./rspack": {
      "types": "./dist/rspack.d.ts",
      "import": "./dist/rspack.js"
    },
    "./project": {
      "types": "./dist/project.d.ts",
      "import": "./dist/project.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./schema": "./schemas/twill.schema.json",
    "./typescript-plugin": {
      "types": "./dist/typescript-plugin.d.ts",
      "require": "./dist/typescript-plugin.cjs",
      "default": "./dist/typescript-plugin.cjs"
    },
    "./doctor": {
      "types": "./dist/doctor.d.ts",
      "import": "./dist/doctor.js"
    },
    "./syntax": {
      "types": "./dist/syntax.d.ts",
      "import": "./dist/syntax.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./declarations": {
      "types": "./dist/declarations.d.ts",
      "import": "./dist/declarations.js"
    },
    "./vite-react": {
      "types": "./dist/vite-react.d.ts",
      "import": "./dist/vite-react.js"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "vue": "^3.3.0",
    "@vitejs/plugin-react": "^6.1.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@vitejs/plugin-react": {
      "optional": true
    }
  },
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "module": "./dist/index.js",
  "scripts": {
    "build": "vite build && vite build --config vite.plugin.config.ts && node scripts/prepare-core.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "pnpm run build",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:package": "node tests/consumer.mjs",
    "test:size": "node tests/bundle-size.mjs",
    "test:browser": "playwright test",
    "benchmark": "node benchmarks/compiler.mjs",
    "test": "pnpm run test:unit",
    "benchmark:branching": "node benchmarks/branching.mjs"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plugin-dts": "^5.1.2",
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@rspack/core": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vue/server-renderer": "catalog:",
    "esbuild": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rollup": "catalog:",
    "vue": "catalog:",
    "webpack": "catalog:",
    "@playwright/test": "catalog:"
  }
}
