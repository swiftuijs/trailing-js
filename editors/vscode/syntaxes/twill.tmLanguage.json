{
  "name": "Twill ts",
  "scopeName": "source.twill.ts",
  "patterns": [
    {
      "include": "#defer"
    },
    {
      "include": "#guard-binding"
    },
    {
      "include": "#guard"
    },
    {
      "include": "#switch-expression"
    },
    {
      "include": "#closure-header"
    },
    {
      "match": "(?<=\\})\\s*\\b([A-Za-z_$][\\w$]*)(\\s*:)(?=\\s*\\{)",
      "captures": {
        "1": {
          "name": "entity.name.function.twill"
        },
        "2": {
          "name": "punctuation.separator.twill"
        }
      }
    },
    {
      "include": "source.ts"
    }
  ],
  "repository": {
    "defer": {
      "match": "\\bdefer\\b(?=(?:[^\\S\\r\\n]|/\\*[^\\r\\n]*?\\*/)*\\{)",
      "name": "keyword.control.twill"
    },
    "guard": {
      "match": "\\bguard\\b(?=\\s+(?:const\\b|[^\\s;=:.]))",
      "name": "keyword.control.twill"
    },
    "guard-binding": {
      "name": "meta.guard.binding.twill",
      "begin": "\\b(guard)\\s+(const)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.twill"
        },
        "2": {
          "name": "storage.type.ts"
        }
      },
      "end": "(?<![\\w$.])\\belse\\b(?=\\s*\\{)",
      "endCaptures": {
        "0": {
          "name": "keyword.control.twill"
        }
      },
      "patterns": [
        {
          "include": "source.ts#object-binding-pattern-const"
        },
        {
          "include": "source.ts#array-binding-pattern-const"
        },
        {
          "include": "source.ts"
        }
      ]
    },
    "switch-expression": {
      "name": "meta.switch.expression.twill",
      "begin": "(?<![\\w$.])(switch)\\b(?=\\s*\\()",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.twill"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.twill"
        }
      },
      "patterns": [
        {
          "include": "source.ts#comment"
        },
        {
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            {
              "include": "source.ts#expression"
            }
          ]
        },
        {
          "begin": "\\{",
          "end": "(?=\\})",
          "patterns": [
            {
              "begin": "(?<![\\w$.])(case|default)\\b",
              "beginCaptures": {
                "1": {
                  "name": "keyword.control.twill"
                }
              },
              "end": "(?=:)",
              "patterns": [
                {
                  "include": "source.ts#expression"
                }
              ]
            },
            {
              "include": "source.ts#statements"
            }
          ]
        }
      ]
    },
    "closure-header": {
      "begin": "(\\{)(?=\\s*(?:async\\s+)?(?:[A-Za-z_$][\\w$]*(?:\\s*,\\s*[A-Za-z_$][\\w$]*)*|\\([^;{}]*\\))\\s+in\\b)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.block.begin.twill"
        }
      },
      "end": "\\bin\\b",
      "endCaptures": {
        "0": {
          "name": "keyword.control.twill"
        }
      },
      "patterns": [
        {
          "include": "source.ts"
        }
      ]
    }
  },
  "injections": {
    "L:source.twill.ts -comment -string": {
      "patterns": [
        {
          "include": "#defer"
        },
        {
          "include": "#guard-binding"
        },
        {
          "include": "#guard"
        },
        {
          "include": "#switch-expression"
        },
        {
          "include": "#closure-header"
        }
      ]
    }
  }
}
