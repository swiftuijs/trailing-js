{
  "name": "Twill ts",
  "scopeName": "source.twill.ts",
  "patterns": [
    {
      "include": "#defer"
    },
    {
      "include": "#guard"
    },
    {
      "include": "#closure-header"
    },
    {
      "match": "(?<=\\})\\s*\\b([A-Za-z_$][\\w$]*)(\\s*:)(?=\\s*\\{)",
      "captures": {
        "1": {
          "name": "entity.name.function.twill"
        },
        "2": {
          "name": "punctuation.separator.twill"
        }
      }
    },
    {
      "include": "source.ts"
    }
  ],
  "repository": {
    "defer": {
      "match": "\\bdefer\\b(?=(?:[^\\S\\r\\n]|/\\*[^\\r\\n]*?\\*/)*\\{)",
      "name": "keyword.control.twill"
    },
    "guard": {
      "match": "\\bguard\\b(?=\\s+(?:const\\b|[^\\s;=:.]))",
      "name": "keyword.control.twill"
    },
    "closure-header": {
      "begin": "(\\{)(?=\\s*(?:async\\s+)?(?:[A-Za-z_$][\\w$]*(?:\\s*,\\s*[A-Za-z_$][\\w$]*)*|\\([^;{}]*\\))\\s+in\\b)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.block.begin.twill"
        }
      },
      "end": "\\bin\\b",
      "endCaptures": {
        "0": {
          "name": "keyword.control.twill"
        }
      },
      "patterns": [
        {
          "include": "source.ts"
        }
      ]
    }
  },
  "injections": {
    "L:source.twill.ts -comment -string": {
      "patterns": [
        {
          "include": "#defer"
        },
        {
          "include": "#guard"
        },
        {
          "include": "#closure-header"
        }
      ]
    }
  }
}
