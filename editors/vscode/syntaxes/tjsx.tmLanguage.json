{
  "name": "Trailing js.jsx",
  "scopeName": "source.trailing.jsx",
  "patterns": [
    {
      "include": "#guard"
    },
    {
      "include": "#closure-header"
    },
    {
      "match": "(?<=\\})\\s*\\b([A-Za-z_$][\\w$]*)(\\s*:)(?=\\s*\\{)",
      "captures": {
        "1": {
          "name": "entity.name.function.trailing"
        },
        "2": {
          "name": "punctuation.separator.trailing"
        }
      }
    },
    {
      "include": "source.js.jsx"
    }
  ],
  "repository": {
    "guard": {
      "match": "\\bguard\\b(?=\\s+(?:const\\b|[^\\s;=:.]))",
      "name": "keyword.control.trailing"
    },
    "closure-header": {
      "begin": "(\\{)(?=\\s*(?:async\\s+)?(?:[A-Za-z_$][\\w$]*(?:\\s*,\\s*[A-Za-z_$][\\w$]*)*|\\([^;{}]*\\))\\s+in\\b)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.block.begin.trailing"
        }
      },
      "end": "\\bin\\b",
      "endCaptures": {
        "0": {
          "name": "keyword.control.trailing"
        }
      },
      "patterns": [
        {
          "include": "source.js.jsx"
        }
      ]
    }
  },
  "injections": {
    "L:source.trailing.jsx -comment -string": {
      "patterns": [
        {
          "include": "#guard"
        },
        {
          "include": "#closure-header"
        }
      ]
    }
  }
}
