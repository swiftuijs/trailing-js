{
  "name": "twill",
  "displayName": "Twill",
  "description": "Syntax highlighting and TypeScript language support for the Twill JS/TS syntax-sugar language.",
  "version": "0.3.0",
  "publisher": "swiftuijs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/swiftuijs/twill"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:twill-typescript",
    "onLanguage:twill-javascript",
    "onLanguage:twill-tsx",
    "onLanguage:twill-jsx"
  ],
  "contributes": {
    "languages": [
      {
        "id": "twill-typescript",
        "aliases": [
          "Twill TypeScript",
          "twill"
        ],
        "extensions": [
          ".twill"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "twill-javascript",
        "aliases": [
          "Twill JavaScript",
          "twill.js"
        ],
        "extensions": [
          ".twill.js"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "twill-tsx",
        "aliases": [
          "Twill TSX",
          "twillx"
        ],
        "extensions": [
          ".twillx"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "twill-jsx",
        "aliases": [
          "Twill JSX",
          "twill.jsx"
        ],
        "extensions": [
          ".twill.jsx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "twill-typescript",
        "scopeName": "source.twill.ts",
        "path": "./syntaxes/twill.tmLanguage.json"
      },
      {
        "language": "twill-javascript",
        "scopeName": "source.twill.js",
        "path": "./syntaxes/twill.js.tmLanguage.json"
      },
      {
        "language": "twill-tsx",
        "scopeName": "source.twill.tsx",
        "path": "./syntaxes/twillx.tmLanguage.json"
      },
      {
        "language": "twill-jsx",
        "scopeName": "source.twill.jsx",
        "path": "./syntaxes/twill.jsx.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "twill.showGenerated",
        "title": "Twill: Show Generated TypeScript"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "twill.config.json",
        "url": "./twill.schema.json"
      }
    ]
  }
}
