{
  "name": "twill",
  "displayName": "Twill",
  "description": "Syntax highlighting and TypeScript language support for the Twill JS/TS syntax-sugar language.",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/prepare-editor.mjs",
    "package": "pnpm --filter twill... run build && pnpm verify && node scripts/package-editor.mjs && node tests/verify-vsix.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "node tests/verify-editor-plugin.mjs",
    "test": "node tests/test-editor.mjs",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage:host": "c8 --exclude-after-remap --check-coverage --statements=98 --lines=98 --functions=100 --branches=95 --include=\"**/extension.ts\" --extension=.ts --extension=.js --extension=.cjs --reporter=text --reporter=json --reporter=json-summary --reporter=html node tests/test-editor.mjs && node tests/verify-coverage.mjs"
  },
  "publisher": "swiftuijs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/swiftuijs/twill"
  },
  "engines": {
    "vscode": "^1.95.3"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:twill-typescript",
    "onLanguage:twill-tsx"
  ],
  "contributes": {
    "languages": [
      {
        "id": "twill-typescript",
        "aliases": [
          "Twill TypeScript",
          "twill"
        ],
        "extensions": [
          ".twill"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "twill-tsx",
        "aliases": [
          "Twill TSX",
          "twillx"
        ],
        "extensions": [
          ".twillx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "twill-typescript",
        "scopeName": "source.twill.ts",
        "path": "./syntaxes/twill.tmLanguage.json"
      },
      {
        "language": "twill-tsx",
        "scopeName": "source.twill.tsx",
        "path": "./syntaxes/twillx.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "twill.showGenerated",
        "title": "Twill: Show Generated TypeScript"
      },
      {
        "command": "twill.projectInfo",
        "title": "Twill: Show Project Diagnostics"
      },
      {
        "command": "twill.debugFile",
        "title": "Twill: Debug Current File"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "twill.config.json",
        "url": "./twill.schema.json"
      }
    ],
    "typescriptServerPlugins": [
      {
        "name": "@swiftuijs/twill-vscode-tsserver",
        "enableForWorkspaceTypeScriptVersions": true
      }
    ]
  },
  "extensionDependencies": [
    "vscode.typescript-language-features"
  ],
  "dependencies": {
    "@swiftuijs/twill-vscode-tsserver": "workspace:*"
  },
  "devDependencies": {
    "@shikijs/langs": "2.5.0",
    "@swiftuijs/twill": "workspace:*",
    "@swiftuijs/twill-formatter": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/vscode": "catalog:",
    "@vscode/test-electron": "catalog:",
    "@vscode/vsce": "catalog:",
    "c8": "12.0.0",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vscode-oniguruma": "catalog:",
    "vscode-textmate": "catalog:",
    "yauzl": "catalog:"
  }
}
