{
  "name": "twill",
  "displayName": "Twill",
  "description": "Syntax highlighting and TypeScript language support for the Twill JS/TS syntax-sugar language.",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node ../../scripts/prepare-editor.mjs",
    "package": "pnpm --filter twill... run build && pnpm verify && node ../../scripts/package-editor.mjs && node ../../scripts/verify-vsix.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "node ../../scripts/verify-editor-plugin.mjs",
    "test": "node ../../scripts/test-editor.mjs"
  },
  "publisher": "swiftuijs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/swiftuijs/twill"
  },
  "engines": {
    "vscode": "^1.95.3"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:twill-typescript",
    "onLanguage:twill-tsx"
  ],
  "contributes": {
    "languages": [
      {
        "id": "twill-typescript",
        "aliases": [
          "Twill TypeScript",
          "twill"
        ],
        "extensions": [
          ".twill"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "twill-tsx",
        "aliases": [
          "Twill TSX",
          "twillx"
        ],
        "extensions": [
          ".twillx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "twill-typescript",
        "scopeName": "source.twill.ts",
        "path": "./syntaxes/twill.tmLanguage.json"
      },
      {
        "language": "twill-tsx",
        "scopeName": "source.twill.tsx",
        "path": "./syntaxes/twillx.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "twill.showGenerated",
        "title": "Twill: Show Generated TypeScript"
      },
      {
        "command": "twill.projectInfo",
        "title": "Twill: Show Project Diagnostics"
      },
      {
        "command": "twill.debugFile",
        "title": "Twill: Debug Current File"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "twill.config.json",
        "url": "./twill.schema.json"
      }
    ],
    "typescriptServerPlugins": [
      {
        "name": "@swiftuijs/twill-vscode-tsserver",
        "enableForWorkspaceTypeScriptVersions": true
      }
    ]
  },
  "extensionDependencies": [
    "vscode.typescript-language-features"
  ],
  "dependencies": {
    "@swiftuijs/twill-vscode-tsserver": "workspace:*"
  },
  "devDependencies": {
    "@swiftuijs/twill": "workspace:*",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "@types/node": "^26.6.4",
    "@types/vscode": "^1.140.0",
    "@swiftuijs/twill-formatter": "workspace:*",
    "prettier": "^3.9.9"
  }
}
