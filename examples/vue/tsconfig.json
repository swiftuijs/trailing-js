{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "vue",
    "types": ["node", "vite/client"]
  },
  "include": ["*.twill", "*.ts", "*.twillx"],
  "exclude": ["node_modules", "dist"]
}
