import { useState } from 'react';
import { components } from '@swiftuijs/trailing-js/react';
import { VStack as ReactVStack, HStack as ReactHStack, Text as ReactText, Button as ReactButton } from '@swiftuijs/ui';

// The compiler knows nothing about @swiftuijs/ui. These are ordinary adapters
// that work with any React component, including ones that use hooks.
const { VStack, HStack, Text, Button } = components({
  VStack: ReactVStack,
  HStack: ReactHStack,
  Text: ReactText,
  Button: ReactButton,
});

export default function App() {
  const [count, setCount] = useState(0);
  return VStack({ spacing: 16 }) {
    Text({ key: "count" }) { `Count: ${count}` };
    HStack({ key: "actions", spacing: 8 }) {
      Button({ key: "increment", onClick: () => setCount(value => value + 1) }) { 'Increment' };
      if (count > 0) {
        Button({ key: "reset", onClick: () => setCount(0) }) { 'Reset' };
      }
    };
  };
}
