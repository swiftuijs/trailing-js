{
  "name": "@swiftuijs/twill-example-library",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && twill declarations -p tsconfig.json -o dist",
    "typecheck": "twill check -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@swiftuijs/twill": "workspace:*",
    "@types/node": "^26.6.4",
    "vite": "^8.3.2",
    "@swiftuijs/twill-formatter": "workspace:*",
    "@swiftuijs/twill-linter": "workspace:*",
    "prettier": "^3.9.9",
    "eslint": "^10.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ]
}
