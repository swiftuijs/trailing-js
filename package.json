{
  "version": "0.7.0",
  "description": "Twill: a JS/TS syntax-sugar language with trailing closures, guards, block-scoped defer, build plugins, type checking, and editor support.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swiftuijs/twill.git"
  },
  "license": "MIT",
  "type": "module",
  "name": "twill-workspace",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@rspack/core": "^2.2.8",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.140.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "@vue/server-renderer": "^3.5.43",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rollup": "^4.64.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "vue": "^3.5.43",
    "webpack": "^5.111.1",
    "yauzl": "^3.4.0",
    "@swiftuijs/twill": "workspace:*",
    "@swiftuijs/twill-formatter": "workspace:*",
    "@swiftuijs/twill-linter": "workspace:*",
    "eslint": "^10.12.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "tsc --noEmit && pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm build && pnpm typecheck && pnpm test && pnpm lint && pnpm format:check && pnpm test:package && pnpm editor:package",
    "test:package": "node scripts/verify-package.mjs",
    "editor:build": "pnpm --filter twill... run build && pnpm --filter twill verify",
    "editor:package": "pnpm --filter twill package",
    "editor:test": "pnpm --filter twill test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:react": "pnpm --filter @swiftuijs/twill-example-react dev",
    "dev:vue": "pnpm --filter @swiftuijs/twill-example-vue dev",
    "example:check": "pnpm --filter './examples/*' run typecheck",
    "benchmark": "node scripts/benchmark.mjs",
    "dev:general": "pnpm --filter @swiftuijs/twill-example-general dev",
    "dev:defer": "pnpm --filter @swiftuijs/twill-example-defer dev",
    "dev:mixed": "pnpm --filter @swiftuijs/twill-example-mixed dev",
    "package:core": "pnpm --filter @swiftuijs/twill pack --out swiftuijs-twill-%v.tgz",
    "example:build": "pnpm --filter './examples/*'... run build",
    "lint": "eslint examples",
    "lint:fix": "eslint examples --fix",
    "benchmark:project": "node scripts/benchmark-project.mjs",
    "package:tooling": "pnpm --filter @swiftuijs/twill-formatter pack --out swiftuijs-twill-formatter-%v.tgz && pnpm --filter @swiftuijs/twill-linter pack --out swiftuijs-twill-linter-%v.tgz",
    "test:tooling": "pnpm package:core && pnpm package:tooling && node scripts/verify-tooling.mjs"
  }
}
