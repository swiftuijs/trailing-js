{
  "name": "@swiftuijs/trailing-js",
  "version": "0.1.0",
  "description": "Swift-style trailing closures for JavaScript and TypeScript with build plugins, type checking, editor support, and optional React/Vue adapters.",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p editors/vscode/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm test && npm run build && npm run test:package && npm run editor:package",
    "test:package": "node scripts/verify-package.mjs",
    "editor:build": "node scripts/build-editor.mjs",
    "editor:package": "npm run editor:build && cd editors/vscode && vsce package --allow-missing-repository --out ../../dist/trailing-js.vsix",
    "prepack": "npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:react": "vite examples/react",
    "dev:vue": "vite examples/vue",
    "example:check": "node dist/cli.js check -p examples/basic/tsconfig.json && node dist/cli.js check -p examples/react/tsconfig.json && node dist/cli.js check -p examples/vue/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swiftuijs/trailing-js.git"
  },
  "keywords": [
    "javascript",
    "typescript",
    "trailing-closures",
    "swift",
    "vite",
    "unplugin",
    "react",
    "vue"
  ],
  "author": "Saiya",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/swiftuijs/trailing-js/issues"
  },
  "homepage": "https://github.com/swiftuijs/trailing-js#readme",
  "dependencies": {
    "@ampproject/remapping": "^2.3.0",
    "@jridgewell/trace-mapping": "^0.3.31",
    "acorn": "8.18.0",
    "acorn-jsx": "^5.3.2",
    "acorn-typescript": "1.4.13",
    "magic-string": "^1.4.2",
    "typescript": "^5.9.3",
    "unplugin": "^3.4.0"
  },
  "devDependencies": {
    "@rspack/core": "^2.2.8",
    "@swiftuijs/ui": "^0.1.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.140.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@vscode/vsce": "^4.0.0",
    "@vue/server-renderer": "^3.5.43",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rollup": "^4.64.0",
    "sass": "^1.105.1",
    "tsup": "^8.5.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "vue": "^3.5.43",
    "webpack": "^5.111.1"
  },
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "trailing-js": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./rollup": {
      "types": "./dist/rollup.d.ts",
      "import": "./dist/rollup.js"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "import": "./dist/esbuild.js"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "import": "./dist/webpack.js"
    },
    "./rspack": {
      "types": "./dist/rspack.d.ts",
      "import": "./dist/rspack.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./project": {
      "types": "./dist/project.d.ts",
      "import": "./dist/project.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./schema": "./schemas/trailing.schema.json"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  }
}
